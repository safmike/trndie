---
pagination:
  data: rankedCities
  size: 1
  alias: city
permalink: "/{{ city.slug }}/"
layout: base.njk
bodyClass: page-city-v2
pageStylesheet: /css/city-v2.css
---
<div class="cityv2" data-city="{{ city.slug }}">

  <header class="cityv2-head">
    <div class="cityv2-head-inner">
      <a href="/" class="cityv2-back">← trndie</a>
      <h1 class="cityv2-title shimmer-arrival">{{ city.name }}</h1>
      <p class="cityv2-tagline">{{ city.tagline }}</p>
      <div class="cityv2-meta">
        <span class="cityv2-stamp">Updated {{ city.lastUpdatedDisplay }}</span>
        <span class="cityv2-tier">Tier {{ city.tier }}</span>
      </div>
    </div>
  </header>

  <nav class="vibe-strip" aria-label="Filter by vibe">
    <div class="vibe-strip-inner">
      {%- for tag in city.vibeTags %}
      <button type="button" class="vibe-pill" data-vibe="{{ tag.value }}" aria-pressed="false">{{ tag.label }}</button>
      {%- endfor %}
      <button type="button" class="vibe-clear" hidden>Clear</button>
    </div>
  </nav>

  <main class="cityv2-main">
    <div class="cityv2-main-inner">
      <p class="cityv2-empty" hidden>Nothing matches those vibes yet — loosen the filter.</p>
      <div class="venue-grid-v2">
        {%- for venue in city.venues %}
        <article class="vcard{% if not venue.cover_photo_url %} vcard--typo{% endif %}"
                 data-venue="{{ venue.venue_name }}"
                 data-vibes="{% for t in venue.vibe_tag_objs %}{{ t.value }}{% if not loop.last %} {% endif %}{% endfor %}">

          <div class="vcard-cover">
            {%- if venue.cover_photo_url %}
            <img class="vcard-photo" src="{{ venue.cover_photo_url }}"
                 alt="{{ venue.venue_name }}, {{ venue.suburb }}" loading="lazy">
            {%- else %}
            <div class="vcard-typo" aria-hidden="true">
              <span class="vcard-typo-name">{{ venue.venue_name }}</span>
              <span class="vcard-typo-vibes">
                {%- for t in venue.vibe_tag_objs %}{{ t.label }}{% if not loop.last %} · {% endif %}{% endfor %}
              </span>
            </div>
            {%- endif %}

            <button type="button" class="vcard-save"
                    aria-pressed="false"
                    aria-label="Save {{ venue.venue_name }}">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
              </svg>
            </button>
          </div>

          <div class="vcard-body">
            <div class="vcard-headrow">
              <h2 class="vcard-name">{{ venue.venue_name }}</h2>
              <span class="vcard-suburb">{{ venue.suburb }}</span>
            </div>

            <p class="vcard-copy">{{ venue.trending_copy }}</p>

            {%- if venue.must_try %}
            <p class="vcard-musttry">
              <span class="vcard-musttry-label">Order</span> {{ venue.must_try }}
            </p>
            {%- endif %}

            <div class="vcard-vibes">
              {%- for t in venue.vibe_tag_objs %}
              <button type="button" class="vcard-vibe" data-vibe="{{ t.value }}">{{ t.label }}</button>
              {%- endfor %}
            </div>

            {%- if venue.source_urls and venue.source_urls.length %}
            <p class="vcard-sources">
              <span class="vcard-sources-label">Spotted in</span>
              {%- for s in venue.source_urls %}<a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.source }}</a>{% if not loop.last %}, {% endif %}{%- endfor %}
            </p>
            {%- endif %}
          </div>

        </article>
        {%- endfor %}
      </div>
    </div>
  </main>

  <footer class="cityv2-foot">
    <a href="/" class="cityv2-foot-link">trndie</a>
    <span>Eight cities, refreshed twice a week.</span>
  </footer>

</div>
<script src="/js/city-v2.js"></script>
