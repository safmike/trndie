{
  "name": "trndie",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "serve": "eleventy --serve --watch",
    "update-trends": "node scripts/update-trends.js",
    "update-trends:city": "node scripts/update-trends.js --city",
    "update-trends:dry": "node scripts/update-trends.js --dry-run",
    "phase2:editorial": "node scripts/phase2-editorial.js",
    "phase2:editorial:fixtures": "node scripts/phase2-editorial.js --fixtures",
    "phase2:editorial:live": "node scripts/phase2-editorial.js --live",
    "phase2:editorial:verify": "node scripts/phase2-editorial.js --verify-feeds --live"
  },
  "dependencies": {
    "apify-client": "^2.9.4",
    "google-trends-api": "^4.9.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  }
}
